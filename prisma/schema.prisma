// Prisma schema for Lumina — camada de tesouraria inteligente para PMEs
// Modela agregação patrimonial (Open Finance), simulação de Split Payment,
// crédito contextual (BaaS) e cobrança B2B (Pix Automático).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  ADMIN
  FINANCEIRO
  VISUALIZADOR
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum ConsentStatus {
  ATIVO
  EXPIRADO
  REVOGADO
}

enum InvoiceStatus {
  PENDENTE
  PAGA
  ATRASADA
  FALHOU
}

enum PaymentMethod {
  PIX_AUTOMATICO
  PIX_MANUAL
  BOLETO
  CARTAO
}

enum CreditOfferStatus {
  OFERTADO
  ACEITO
  RECUSADO
  EXPIRADO
}

model Company {
  id          String    @id @default(cuid())
  name        String
  cnpj        String    @unique
  taxRegime   TaxRegime @default(SIMPLES_NACIONAL)
  sector      String    @default("Serviços")
  plan        Plan      @default(STARTER)
  createdAt   DateTime  @default(now())

  users        User[]
  bankAccounts BankAccount[]
  invoices     Invoice[]
  creditOffers CreditOffer[]
  subscription Subscription?
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
}

model BankAccount {
  id              String        @id @default(cuid())
  institution     String
  accountType     String        @default("Conta Corrente")
  balanceCents    Int
  consentStatus   ConsentStatus @default(ATIVO)
  consentExpires  DateTime
  lastSyncedAt    DateTime      @default(now())
  createdAt       DateTime      @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amountCents Int
  isCredit    Boolean
  category    String   @default("Outros")
  occurredAt  DateTime

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String
}

model Invoice {
  id                String        @id @default(cuid())
  customerName      String
  customerDocument  String
  grossAmountCents  Int
  ibsAmountCents    Int
  cbsAmountCents    Int
  netAmountCents    Int
  status            InvoiceStatus @default(PENDENTE)
  paymentMethod     PaymentMethod @default(PIX_AUTOMATICO)
  recurring         Boolean       @default(false)
  pixMandateActive  Boolean       @default(true)
  issuedAt          DateTime      @default(now())
  dueDate           DateTime
  paidAt            DateTime?
  failureReason     String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
}

model CreditOffer {
  id             String            @id @default(cuid())
  amountCents    Int
  scoreValue     Int
  scoreFactors   String
  status         CreditOfferStatus @default(OFERTADO)
  baasPartner    String            @default("Celcoin Instituição de Pagamento S.A.")
  decisionReason String
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
}

model Subscription {
  id               String   @id @default(cuid())
  plan             Plan     @default(STARTER)
  pricePerMonthCents Int
  currentPeriodEnd DateTime
  active           Boolean  @default(true)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique
}
